#!/bin/bash
#SBATCH --nodes 1
#SBATCH --ntasks-per-node=2
#SBATCH --threads-per-core=1
#SBATCH --cpus-per-task=24
#SBATCH --mail-user=fubiani@laplace.univ-tlse.fr
#SBATCH --mail-type=BEGIN
#SBATCH --mail-type=END
#SBATCH --mail-type=FAIL
#SBATCH --mail-type=ALL
##SBATCH --partition=skl_fua_dbg
#SBATCH --partition=skl_fua_prod
#SBATCH --qos=skl_qos_fualprod
#SBATCH --account=FUA38_NISC
#SBATCH -t 24:00:00

module load env-skl
module load intel/pe-xe-2018--binary
module load intelmpi/2018--binary
module load mkl/2018--binary

rm -f DATA/*
rm -f DATA/DATA_2D/*.*

export OMP_NUM_THREADS=24
export OMP_PROC_BIND=true

mpiexec.hydra ./2dphpic.exe > run.dump

