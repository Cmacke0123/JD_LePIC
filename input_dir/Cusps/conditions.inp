argon_ex.dat ! name of file storing reactions
2. ! Te (eV) 
6 ! # of levels in MG solver
1.d-7 ! Min. precision in residual
128 64 ! n: nx=2**n, ny=2**n. Number of grid points [2**7,2**3]
0. 0.2 0. 100. ! Particle heating/injection region x<, x>[cm] (<0 for a disk), y<, y>
2. ! Particle loading region [cm]
3 ! # of magnetic field files (<0 positive ions not magnetized)      
s gauss 1. 100. Bz 8.d10 0.5 0. ! ext. file (y/n/s), name, scaling, B(G)(<0 mirror), dir, L(cm)(<0 -B LHS), x0(cm), y0(cm)
n ext 1. 400. By 1. 2. 0. ! ext. file (y/n/s), name, scaling, B(G)(<0 mirror), dir, L(cm)(<0 -B LHS), x0(cm), y0(cm)
s 2Dzoom512_32 1. 75. Bz 8. 39. 0. ! ext. file (y/n/s), name, scaling, B(G)(<0 mirror), dir, L(cm)(<0 -B LHS), x0(cm), y0(cm)
1 -1.d3 1.d9 ! # of drivers (<0 = iterative P), Pabs(W) (n times, <0 for a fixed Te), heating freq. (<0 == off)
5. -2 ! ! Inject current I(A) (<0 == off), options (1=fixed, 2= equal to ion losses, 3= beam along Z, <0= gaussian)
1.d-2 ! t_max(s)
0.3  ! time coeff. k ; dt= k*dx/vt
2.d15 ! n0 (m-3)
3.2d18 ! ng (m-3)
50 ! np_cell: number of particles per cell
5 ! Number of wall labels
-2500 ! Frequency for saving data (<0 does not reset averaging)
2500 ! Frequency for simulation backup (<0 no averaging)
1 ! Size ratio of arrays used for saving data
1.d0 ! k_eps0 
no 1 0. 10.  1  0. 10. ! Save pdf (y/n), ptype, yl & yr (cm), # of regions n_rg, xl & xr (cm) for each n_rg
yes 14 2 1 ! Restart (yes/no/external),  # of OMP threads, # of MPI, # for particle duplication
no 2.45 2.85 1.6 0.8 1 n 2 ! PG (y/n), x1/x2/Lg/Lh (cm), # holes, sum index (y/n), index (if not)
0. 270. 3 ! jH-(mA/cm2) from H, Tbeam(eV) (<0 Te for e-ion pair injection), characteristics of neg. ions on grid # [index]
-0.57 100. 0. 1 1.d-9 ! h=ns/<n> [<0 length=1m and no losses], length in 3rd dim (cm), bias(V), opts (1=metal, 2=float), capacitance
END

