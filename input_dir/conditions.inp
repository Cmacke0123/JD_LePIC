Shydrogen.dat 0 0.9 ! name of file storing reactions, ionization scheme (0: preserve energy & mom, 1: fixed repartition), Ek ratio for elec.
7. ! Te (eV) 
7 ! # of levels in MG solver
1.d-8 ! Min. precision in residual
128 192 1 ! n: nx=2**n, ny=2**n. Number of grid points [2**7,2**3], opt_solver: 1 (MG), 2 (Pardiso)
0. 16. 0. 100. ! Particle heating/injection region x<, x>[cm] (<0 for a disk), y<, y>
40. ! Particle loading region [cm]
3 ! # of magnetic field files (<0 positive ions not magnetized)
128 64 ! Grid for the magnetic field map
n gauss 1. 75. Bz 8. 39. 0. ! ext. file (y/n/s), name, scaling, B(G)(<0 mirror), dir, L(cm)(<0 -B LHS), x0(cm), y0(cm) or B(T) @ x0
s ext 1. 400. By 2.5 5. 0. ! ext. file (y/n/s), name, scaling, B(G)(<0 mirror), dir, L(cm)(<0 -B LHS), x0(cm), y0(cm) or B(T) @ x0
s 2Dzoom512_32 1. 75. Bz 8. 39. 0. ! ext. file (y/n/s), name, scaling, B(G)(<0 mirror), dir, L(cm)(<0 -B LHS), x0(cm), y0(cm) or B(T) @ x0
1 60.d3 1.d8 ! # of drivers (<0 = iterative P), Pabs(W) (n times, <0 for a fixed Te), heat. freq. (<0 == off)
-1.d0 2 ! ! Inject current I(A) (<0 == off), options (1=fixed, 2= equal to ion losses, 3= beam along Z, <0= gaussian)
2.d-2 ! t_max(s)
0.3  ! time coeff. k ; dt= k*dx/vt
3.5d17 ! n0 (m-3)
5.d19 ! ng (m-3)
20 ! np_cell: number of particles per cell (<0 for no background plasma)
5 ! Number of wall labels
2500 ! Frequency for saving data (<0 does not reset averaging)
2500 100 0 20.e-6 ! Frequency for simulation backup (<0 no averaging), # of plots (<0 off), time window [t1,t2]
1 ! Size ratio of arrays used for saving data
36000.d0 ! k_eps0 
no 1 0. 26.  1  0. 26. ! Save pdf (y/n), ptype, yl & yr (cm), # of regions n_rg, xl & xr (cm) for each n_rg
no 14 2 1 ! Restart (yes/no/external/gauss),  # of OMP threads, # of MPI, # for particle duplication
yes 40. 40. 27.8 1. 0 n 4 ! particle flux off a surface : draw segment (y/n), x1/x2/Lg/Lh (cm), # holes, sum index (y/n), wall index
0. 3 1. 4 ! |js|(mA/cm2), ptype, Tbeam(eV) (<0 Te for e-ion pair injection), part. moments on grid #[index] (<0 for phase-space)
0.57 32. 0. 1  1.d-6 ! h=ns/<n> [<0 length=1m and no losses], length in 3rd dim (cm), bias(V), opts (1=metal, 2=floating), capacitance (F/m2)
-0.1 2 no 125. 800.d6 0. 0. ! Secondary emission coeff (<0 == off), grid index (<0, fixed current instead), RF (yes/no), phi0(V), f0(Hz), phi1(V), f1(Hz)
END

