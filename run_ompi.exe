#!/bin/sh
i=$( date +%s )

rm -f DATA/*

echo '*** Start calculation ... ***'
ulimit -s "unlimited"
export OMP_NUM_THREADS=8
export OMP_PROC_BIND=true
#export KMP_AFFINITY="verbose,explicit,proclist=[1,2,3]"
time mpirun -np 2 --map-by socket -bind-to socket ./2dphpic32.exe

set k=$0
j=$( date +%s )
k=$(($j-$i))
i=$(($k/60))
j=$(($k-$i*60))
echo -n " Total calculation time : "
echo $i "min" $j "sec"

